# Resend (transactional email — used by all forms, including the
# partnership notification/confirmation emails)
RESEND_API_KEY=
FROM_EMAIL=
TO_EMAIL=

# Site URL used for canonical/OpenGraph metadata (lib/seo.ts). Defaults to
# https://powerdon.nl if unset.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (bot challenge on /reserve/form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (sliding-window rate limiting on /reserve/form)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
