# PowerDon environment variables
# Copy to .env.local for development. Set the same keys in
# Vercel → Project Settings → Environment Variables for production.

# --- Existing (already in use by contact/reserve/advertising forms) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=hello@powerdon.nl
TO_EMAIL=branding@powerdon.nl

# --- Affiliate area (new) ---
# Where new affiliate applications are emailed. Falls back to TO_EMAIL if unset.
AFFILIATE_ADMIN_EMAIL=partners@powerdon.nl

# Password the admin uses to sign in at /affiliate/login. Min 8 chars.
AFFILIATE_ADMIN_PASSWORD=change-me-in-vercel

# Secret used to sign the admin session cookie (HMAC-SHA256). Min 32 chars.
# Generate with: openssl rand -base64 48
AFFILIATE_SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# --- SEO ---
NEXT_PUBLIC_SITE_URL=https://powerdon.nl
